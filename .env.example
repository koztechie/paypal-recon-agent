# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Uniform style: all values single-quoted (no expansion, literal).

# --- PayPal sandbox (stage 25) ---
PAYPAL_CLIENT_ID='REPLACE_WITH_CLIENT_ID'
PAYPAL_CLIENT_SECRET='REPLACE_WITH_CLIENT_SECRET'
PAYPAL_ENVIRONMENT='SANDBOX'

# --- PayPal sandbox test accounts (stage 27) ---
SANDBOX_BUSINESS_EMAIL='sb-...@business.example.com'
SANDBOX_BUSINESS_PASSWORD='REPLACE'
SANDBOX_BUYER_EMAIL='sb-...@personal.example.com'
SANDBOX_BUYER_PASSWORD='REPLACE'

# --- LLM (stage 28) ---
LLM_API_KEY='REPLACE_WITH_LLM_KEY'
LLM_PROVIDER='gemini'
LLM_MODEL='gemini-3.5-flash-lite'

# --- Dry-run (stage 50; keyless demos, stage 123) ---
# true  -> money actions simulated, no PayPal credentials required (npm run demo
#          works on a fresh clone out of the box; nothing real is touched).
# false -> real sandbox calls; PayPal creds below become mandatory.
DRY_RUN='true'

# --- Server / Render (stages 35, 115-118) ---
# Render sets PORT automatically; local default is 3000.
PORT='3000'
# Public base URL of the deployed app (used by PayPal webhook listener).
# Local dev: tunnel URL (stage 36). Production: https://<app>.onrender.com
BASE_URL='REPLACE_WITH_PUBLIC_BASE_URL'
# Webhook id from the PayPal dashboard (Developers > Webhooks). REQUIRED in production:
# when set, POST /webhook verifies every delivery signature via
# /v1/notifications/verify-webhook-signature and rejects forgeries (security C-1).
# Prod: 83733119MV984010C | dev/ngrok: 2VN59522XH443900A
WEBHOOK_ID=''

# Shared secret for the state-changing endpoints (/api/action, /api/recon/run,
# /api/negotiate) — REQUIRED in production (security C-2). Generate with:
#   openssl rand -hex 32
# Send requests as: Authorization: Bearer <token>  (or X-Action-Token: <token>)
ACTION_TOKEN=''

# Extra browser origins allowed to call the API cross-origin (comma separated).
# The service's own origin is always allowed; the local UI is pre-listed.
# Any other origin gets NO CORS headers (security C-3).
CORS_ORIGINS=''
